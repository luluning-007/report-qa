# ============================================================
# .gitignore —— 告诉 Git 哪些文件不要上传
# ============================================================

# ---------- 虚拟环境（几百 MB，绝对不能传）----------
.venv/
venv/
env/

# ---------- Python 缓存 ----------
__pycache__/
*.pyc
*.pyo
*.pyd

# ---------- jieba 缓存（9 MB）----------
jieba.cache

# ---------- 本机凭据 / 敏感信息 ----------
.env
*.key
secrets.toml
.streamlit/credentials.toml
.streamlit/machine_id_v4

# ---------- 系统 / 重定向产生的垃圾 ----------
AppData/
Thumbs.db
desktop.ini
.DS_Store

# ---------- 编辑器配置 ----------
.vscode/
.idea/

# ---------- 日志与临时文件 ----------
*.log
*.tmp
